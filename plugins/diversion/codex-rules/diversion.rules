# Lets Codex run Diversion commands outside its sandbox without asking. dv talks to
# the local Diversion agent over the network, and the sandbox blocks the network.
# Codex applies the strictest matching rule, so the prompt rules below still ask
# before commands that delete data or call the raw API.
# $diversion:setup-permissions copies this file to ~/.codex/rules/.
prefix_rule(
    pattern = ["dv"],
    decision = "allow",
    match = ["dv status", "dv branch -c feature", "dv commit -m x"],
    not_match = ["git status"],
)
prefix_rule(
    pattern = ["dv", ["obliterate", "prune", "api"]],
    decision = "prompt",
    match = ["dv obliterate preview /a.psd", "dv prune add /a.psd --keep 1", "dv api -X DELETE /repos/x"],
    not_match = ["dv status"],
)
prefix_rule(
    pattern = ["dv", "repo", "-d"],
    decision = "prompt",
    match = ["dv repo -d dv.repo.1 -f"],
    not_match = ["dv repo"],
)
prefix_rule(
    pattern = ["dv", "workspace", "delete"],
    decision = "prompt",
    match = ["dv workspace delete --all -f"],
    not_match = ["dv workspace pause"],
)

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if command -v \"dv\" >/dev/null 2>&1; then \"dv\" claude-hook session-start --coding-agent codex; fi'",
            "commandWindows": "dv claude-hook session-start --coding-agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if command -v \"dv\" >/dev/null 2>&1; then \"dv\" claude-hook pre-tool-use --coding-agent codex; fi'",
            "commandWindows": "dv claude-hook pre-tool-use --coding-agent codex",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if command -v \"dv\" >/dev/null 2>&1; then \"dv\" claude-hook post-tool-use --coding-agent codex; fi'",
            "commandWindows": "dv claude-hook post-tool-use --coding-agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if command -v \"dv\" >/dev/null 2>&1; then \"dv\" claude-hook session-end; fi'",
            "commandWindows": "dv claude-hook session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
